# Copy to .env.local for local dev. In production, set these in the Vercel dashboard.

# Prospeo — verified email lookup (primary). 100 verified lookups/mo free tier.
PROSPEO_API_KEY=

# Shared-password gate. Anyone with this password can use the portal.
# Upgrade to per-user accounts (Clerk) later.
SCOUT_PASSWORD=

# Secret used to sign the login cookie. Any long random string.
SCOUT_SESSION_SECRET=

# Optional fallbacks (drop a key in to extend the waterfall):
HUNTER_API_KEY=

# --- Azure Cosmos DB (startup database) ---
# Account URI, e.g. https://<account>.documents.azure.com:443/
COSMOS_ENDPOINT=
# Account key (master or scoped). Server-side only. Never commit.
COSMOS_KEY=
# Buddy gets its own database — never the Overtaxed containers.
COSMOS_DATABASE=buddy
COSMOS_CONTAINER=companies

# --- Azure OpenAI ---
# Resource endpoint, e.g. https://<resource>.openai.azure.com/
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
# Deployment NAMES you created (not model names) — fill after deploying:
AZURE_OPENAI_CHEAP_DEPLOYMENT=
AZURE_OPENAI_MID_DEPLOYMENT=
AZURE_OPENAI_SMART_DEPLOYMENT=
